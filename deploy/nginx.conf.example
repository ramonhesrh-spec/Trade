# Voorbeeld nginx configuratie als reverse proxy voor het dashboard.
# Zet dit bijvoorbeeld in /etc/nginx/sites-available/crypto-alerts en
# maak een symlink naar sites-enabled. Vervang jouw-domein.nl.
#
# Draai daarna: sudo certbot --nginx -d jouw-domein.nl
# Certbot vult automatisch de HTTPS server block aan met Let's Encrypt
# certificaten en zet een cronjob voor automatische vernieuwing.

server {
    listen 80;
    server_name jouw-domein.nl;

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }
}
