[Unit]
Description=Crypto alertsysteem - webdashboard
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crypto
WorkingDirectory=/opt/crypto-alerts
EnvironmentFile=/opt/crypto-alerts/.env
ExecStart=/opt/crypto-alerts/.venv/bin/uvicorn web.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
