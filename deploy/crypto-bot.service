[Unit]
Description=Crypto alertsysteem - Discord bot en verwerking
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=crypto
WorkingDirectory=/opt/crypto-alerts
EnvironmentFile=/opt/crypto-alerts/.env
ExecStart=/opt/crypto-alerts/.venv/bin/python3 main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
