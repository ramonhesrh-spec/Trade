# Discord bot token, van discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Anthropic API key
ANTHROPIC_API_KEY=

# Exchange voor live koersdata (ccxt id, bijvoorbeeld binance of kraken)
EXCHANGE_ID=binance
QUOTE_CURRENCY=USDT

# Uitgebreide technische factoren (ADX, volatiliteit, BTC-trend, 1u
# bevestiging, divergentie, liquiditeit) naast de vier basisfactoren.
# Staat standaard uit, zie de README. Eerst scripts/backtest_factors.py
# draaien voor je dit op true zet.
ENABLE_ADVANCED_FACTORS=false

# Minimale stopafstand van een SMC-signaal in procenten van de entry. Kleinere stops liggen binnen de ruis
# van een minuutcandle (zie het meetraam). 0 zet de toets uit.
SMC_MIN_STOP_PCT=0.4

# Kosten per rondreis (fee plus slippage samen) in procenten van de entry, voor de netto-cijfers op /bewijs en in het
# weekrapport. Een aanname: wat je echt betaalt hangt van je beurs af.
TRACK_RECORD_COST_PCT=0.06

# Geheime sleutel voor JWT sessies, willekeurige lange string
JWT_SECRET=change-me-to-a-random-secret

# Standaard risicopercentage per trade, in procenten, voor een nieuwe
# gebruiker (aan te passen per gebruiker in het dashboard)
DEFAULT_RISK_PERCENT=1.0

# Locatie van de sqlite database
DATABASE_PATH=data/trading.db

# Locatie voor opgeslagen Discord afbeeldingen
IMAGE_STORAGE_PATH=data/images

# Locatie voor dagelijkse back-ups van de database
BACKUP_PATH=data/backups

# Externe locatie voor de back-up, via rsync over SSH, bijvoorbeeld
# user@andere-server:/pad/naar/backups/. Leeg = geen externe kopie.
# Vereist een SSH sleutel zonder wachtwoord tussen deze VPS en die locatie.
BACKUP_REMOTE=

# Beperken van inlogpogingen op het dashboard
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Web Push VAPID-sleutelpaar, genereer met (zie implementatieplan push-
# meldingen voor het volledige commando):
#   python3 -c "from py_vapid import Vapid02; v = Vapid02(); v.generate_keys(); print(v.public_key_str()); print(v.private_key_str())"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_CLAIM_EMAIL=mailto:admin@hespulse.duckdns.org

# Gebruikersnaam van jouw eigen admin-account, bepaalt wie de
# systeemgezondheid-sectie op /meldingen ziet.
ADMIN_USERNAME=

# Beperken van registraties op /registreer, per IP-adres per uur
MAX_REGISTRATIONS_PER_HOUR=5
# Alleen registreren met een geldige uitnodigingscode uit /beheer (true). Standaard open.
REGISTRATION_REQUIRES_INVITE=false
# Startwaarde voor het moment van de aankondiging op /nieuw (Amsterdamse tijd, bv. 2026-11-02T18:00). Leeg = geen. De database wint:
# zet en wis hem zonder herstart met scripts/aankondiging.py --zet/--wis.
ANNOUNCEMENT_AT=

# Openbaar adres van het dashboard, voor toekomstige links vanuit een
# melding of e-mail.
DASHBOARD_URL=https://hespulse.duckdns.org

# Soorten zonder pushmelding (komma-gescheiden: smc, patroon, swing, day_trading). Ze blijven gemeten en zichtbaar op
# Bewijs en het journaal. Leeg = alles blijft aan.
SIGNAL_TYPE_INFO_ONLY=
# Samenval SMC en community-call (ongetest): aan, venster in uren, en na hoeveel afgeronde netto-negatieve samenvallen hij uitgaat.
SAMENVAL_ENABLED=true
SAMENVAL_WINDOW_HOURS=6
SAMENVAL_MAX_NEGATIVE=30

# Extra coins naast de 7 vaste, komma-gescheiden (bijvoorbeeld XRP,HBAR). Alleen de SMC-check draait erop. Toets eerst met
# scripts/replay_smc_report.py --coins ... of ze na kosten positief zijn. Herstart crypto-bot en crypto-web na een wijziging.
EXTRA_COINS=

# Structuur-breuken (app/structure_live.py): Claude beoordeelt breuken van lijnen en ranges op 30m, de code rekent het plan uit.
STRUCTURE_ENABLED=true
STRUCTURE_MAX_ALERTS_PER_DAY=30
# SMC-kansen met een waarschuwing (late entry of lage verhouding) tonen in plaats van weigeren. Standaard false in de code.
SMC_WARNING_ALERTS=true
STRUCTURE_MAX_NEGATIVE=30

# Focus (app/focus.py): alleen Structuur A/B, Structuur C en de zone-radar zoeken en melden nog nieuwe kansen. Alle andere motoren (day trading via
# Discord, patroon, trend, rejectie, markt-script, SMC, swing, samenval, range sweep en range-watch, de proefmotor) staan uit; hun open trades lopen
# door tot ze sluiten en Bewijs houdt hun cijfers. false zet alles terug zoals het was. Standaard true.
ENGINE_FOCUS=true

# Zone-radar (app/zone_radar_live.py): dichtstbijzijnde vraag- en aanbodzone op 1u/4u als limietplan op de Radar, ongetest, voor iedereen.
ZONE_RADAR_ENABLED=true
ZONE_RADAR_MAX_PER_DAY=20
# Zone-sweep (app/zone_sweep_live.py): prik door een actieve zone met herstel, live vóór de labrun op verzoek van de gebruiker, altijd ongetest.
# PUBLIC=false: alleen de CEO ziet kaarten, signalen en cijfers. MAX_PER_DAY: gemelde kaarten per 24 uur, de rest staat stil op de Radar.
ZONE_SWEEP_ENABLED=true
ZONE_SWEEP_PUBLIC=true
ZONE_SWEEP_MAX_PER_DAY=10

# Marktcontext (app/market_context_live.py): funding, OI, Fear and Greed en stablecoins van publieke bronnen (Binance, Hyperliquid, Bybit, OKX,
# alternative.me, DefiLlama) als gemeten feit op kaart, Vandaag en Bewijs. Beslist niets. Standaard aan.
MARKET_CONTEXT_ENABLED=true

# Trend plus pullback (app/trend_live.py). Stille meldingen, ongetest.
TREND_ENABLED=true
TREND_MAX_PER_DAY=6
TREND_MAX_NEGATIVE=40
TREND_RR=2.0

# Range sweep (app/range_sweep_live.py) en range-watch (app/range_watch.py): proef, ongetest. Uit tot de toets op stopkwaliteit is opgeslagen
# (scripts/strategy_lab.py --familie rangesweep --opslaan, zie docs/onderzoek/range-sweep/vps-protocol.md). Zet daarna RANGE_SWEEP_ENABLED op true;
# de range-watch pas na de keuring met het oog. De motor scant de 20 coins van trendlab.LAB_COINS.
RANGE_SWEEP_ENABLED=false
RANGE_WATCH_ENABLED=false
# false: alleen de CEO ziet de kansen, de ranges en de cijfers op Bewijs. true: ook leerlingen.
RANGE_SWEEP_PUBLIC=false
RANGE_SWEEP_MAX_PER_DAY=6
RANGE_WATCH_MAX_PER_DAY=3
# Zet zichzelf uit na zoveel afgeronde proeftrades die samen negatief zijn bij de referentie-uitgang.
RANGE_SWEEP_MAX_NEGATIVE=30
# Voor de kaarten en prijsalarmen van de voorbeeldcoins (ARB, APT, AAVE, WLD) moeten ze in de coinlijst staan: EXTRA_COINS=ARB,APT,AAVE,WLD
# Setups tonen voor de lab-run slaagde (ongetest, zie config.py):
RANGE_SWEEP_UNTESTED=false
