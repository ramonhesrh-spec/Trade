# Discord bot token, van discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Anthropic API key
ANTHROPIC_API_KEY=

# Telegram bot token, via BotFather. Eén bot, elke gebruiker krijgt zijn
# eigen chat ID ingesteld via scripts/create_user.py, niet hier.
TELEGRAM_BOT_TOKEN=

# Exchange voor live koersdata (ccxt id, bijvoorbeeld binance of kraken)
EXCHANGE_ID=binance
QUOTE_CURRENCY=USDT

# Uitgebreide technische factoren (ADX, volatiliteit, BTC-trend, 1u
# bevestiging, divergentie, liquiditeit) naast de vier basisfactoren.
# Staat standaard uit, zie de README. Eerst scripts/backtest_factors.py
# draaien voor je dit op true zet.
ENABLE_ADVANCED_FACTORS=false

# Geheime sleutel voor JWT sessies, willekeurige lange string
JWT_SECRET=change-me-to-a-random-secret

# Standaard risicopercentage per trade, in procenten, voor een nieuwe
# gebruiker (aan te passen per gebruiker in het dashboard)
DEFAULT_RISK_PERCENT=1.0

# Locatie van de sqlite database
DATABASE_PATH=data/trading.db

# Locatie voor opgeslagen Discord afbeeldingen
IMAGE_STORAGE_PATH=data/images

# Locatie voor dagelijkse back-ups van de database
BACKUP_PATH=data/backups

# Externe locatie voor de back-up, via rsync over SSH, bijvoorbeeld
# user@andere-server:/pad/naar/backups/. Leeg = geen externe kopie.
# Vereist een SSH sleutel zonder wachtwoord tussen deze VPS en die locatie.
BACKUP_REMOTE=

# Beperken van inlogpogingen op het dashboard
MAX_LOGIN_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Beperken van registraties op /registreer, per IP-adres per uur
MAX_REGISTRATIONS_PER_HOUR=5

# Openbaar adres van het dashboard, gebruikt in het welkomstbericht dat de
# Discord bot terugstuurt bij iemands allereerste DM.
DASHBOARD_URL=https://hespulse.duckdns.org
