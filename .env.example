# Discord bot token, van discord.com/developers/applications
DISCORD_BOT_TOKEN=

# Anthropic API key
ANTHROPIC_API_KEY=

# Telegram bot token en chat ID, via BotFather en userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Exchange voor live koersdata (ccxt id, bijvoorbeeld binance)
EXCHANGE_ID=binance
QUOTE_CURRENCY=USDT

# Dashboard login, één vaste gebruiker
DASHBOARD_USERNAME=admin
# Genereer een hash met: python3 scripts/create_user.py
DASHBOARD_PASSWORD_HASH=

# Geheime sleutel voor JWT sessies, willekeurige lange string
JWT_SECRET=change-me-to-a-random-secret

# Standaard risicopercentage per trade, in procenten
DEFAULT_RISK_PERCENT=1.0

# Locatie van de sqlite database
DATABASE_PATH=data/trading.db

# Locatie voor opgeslagen Discord afbeeldingen
IMAGE_STORAGE_PATH=data/images

# Locatie voor dagelijkse back-ups van de database
BACKUP_PATH=data/backups
